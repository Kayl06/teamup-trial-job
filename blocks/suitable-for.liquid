<div class="details-group" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <h2 class="details-group__heading">{{ block.settings.heading }}</h2>
  {%- endif -%}
  <div class="details-group__items">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .details-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    color: #251f1a;
  }

  .details-group__heading {
    margin: 0;
    color: #251f1a;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.2;
  }

  .details-group__items {
    width: 100%;
    padding-left: 10px;
    border-left: 1px solid #251f1a;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.suitable_for",
  "tag": null,
  "blocks": [
    {
      "type": "detail-item"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Suitable For:"
    }
  ],
  "presets": [
    {
      "name": "t:names.suitable_for",
      "settings": {
        "heading": "Suitable For:"
      },
      "blocks": {
        "item-1": { "type": "detail-item", "settings": { "text": "ALL HAIR TYPES" } },
        "item-2": { "type": "detail-item", "settings": { "text": "STRAIGHT" } },
        "item-3": { "type": "detail-item", "settings": { "text": "WAVY" } },
        "item-4": { "type": "detail-item", "settings": { "text": "CURLY" } },
        "item-5": { "type": "detail-item", "settings": { "text": "COILY" } },
        "item-6": { "type": "detail-item", "settings": { "text": "EXTENSIONS" } },
        "item-7": { "type": "detail-item", "settings": { "text": "COLOUR-TREATED" } },
        "item-8": { "type": "detail-item", "settings": { "text": "KERATIN & NANOPLASTY TREATED" } }
      },
      "block_order": ["item-1", "item-2", "item-3", "item-4", "item-5", "item-6", "item-7", "item-8"]
    }
  ]
}
{% endschema %}
