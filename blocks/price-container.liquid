{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
  assign variant = product.selected_or_first_available_variant
%}

<div class="price-container" {{ block.shopify_attributes }}>
  {% if variant != blank %}
    <p class="price-container__amount">{{ variant.price | money }}</p>
    {% comment %}
      Swap this line for the Afterpay/Klarna payment-terms app block in a live store.
      Static HTML avoids a third-party script on load.
    {% endcomment %}
    <p class="price-container__installment">
      Or 4 payments of
      <strong class="price-container__installment-amount">{{ variant.price | divided_by: 4 | money }}</strong>
      with
      <svg
        class="price-container__afterpay"
        width="61"
        height="12"
        viewBox="0 0 61 12"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Afterpay"
