        <defs>
          <clipPath id="afterpay-logo-{{ block.id | handleize }}">
            <rect width="61" height="11.7308" fill="white"/>
          </clipPath>
        </defs>
      </svg>
    </p>
  {% endif %}
</div>

{% stylesheet %}
  .price-container {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    margin: 0;
    color: #251f1a;
    margin-top: 8px;
  }

  .price-container__amount {
    margin: 0;
    color: #251f1a;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: normal;
  }

  .price-container__installment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    margin: 0;
    color: #251f1a;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
  }

  .price-container__installment-amount {
    font-weight: 700;
  }

  .price-container__afterpay {
    display: block;
    flex: 0 0 auto;
    width: 61px;
    height: 12px;
    color: #241f1a;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.price_container",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "t:names.price_container"
    }
  ]
}
{% endschema %}
