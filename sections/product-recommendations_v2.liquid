<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'product-recommendations_v2.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign current_product = section.settings.product | default: product
  assign max_products = section.settings.max_products
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign products = blank

  # Recommendations are empty on many dev stores. After that, use the editor
  # collection, then the catalog, so the row still has products on first paint
  # and after the recommendations section request.
  if recommendations.performed and recommendations.products_count > 0
    assign products = recommendations.products | reject: 'id', current_product.id
  endif

  assign shown_count = 0
  if products != blank
    for recommendation in products limit: max_products
      if recommendation.id != blank
        assign shown_count = shown_count | plus: 1
      endif
    endfor
  endif

  if shown_count == 0 and section.settings.fallback_collection != blank
    assign products = section.settings.fallback_collection.products | reject: 'id', current_product.id
    assign shown_count = 0
    for recommendation in products limit: max_products
      if recommendation.id != blank
        assign shown_count = shown_count | plus: 1
      endif
    endfor
  endif

  if shown_count == 0
    assign products = collections.all.products | reject: 'id', current_product.id
    assign shown_count = 0
    for recommendation in products limit: max_products
      if recommendation.id != blank
        assign shown_count = shown_count | plus: 1
      endif
    endfor
  endif

  assign onboarding = false
  if shown_count == 0
    assign onboarding = true
    assign shown_count = 4
  endif
%}

<product-recommendations
  id="product-recommendations-{{ section.id }}"
  class="product-recommendations-v2-root"
  data-url="{{ routes.product_recommendations_url }}?limit={{ max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ current_product.id }}"
  data-intent="{{ section.settings.recommendation_type }}"
  data-recommendations-performed="{{ recommendations.performed }}"
  {{ section.shopify_attributes }}
>
  <div class="section-background product-recommendations-v2__ground"></div>
  <div
    class="section section--page-width product-recommendations-v2 spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% capture header %}
      <div class="product-recommendations-v2__intro">
        {% if eyebrow != blank %}
          <p class="product-recommendations-v2__eyebrow">{{ eyebrow | escape }}</p>
        {% endif %}
        {% if heading != blank %}
          <h2 id="ProductRecommendationsHeading-{{ section.id }}" class="product-recommendations-v2__heading">
            {{ heading | escape }}
          </h2>
        {% endif %}
      </div>
    {% endcapture %}

    {% capture slideshow_arrows %}
      <button
        type="button"
        class="product-recommendations-v2__arrow product-recommendations-v2__arrow--previous"
        ref="previous"
        on:click="/previous"
        aria-label="{{ 'accessibility.slideshow_previous' | t }}"
      >
        <span class="product-recommendations-v2__arrow-icon" aria-hidden="true">
          {{ 'icon-chevron-left.svg' | inline_asset_content }}
        </span>
      </button>
      <button
        type="button"
        class="product-recommendations-v2__arrow product-recommendations-v2__arrow--next"
        ref="next"
        on:click="/next"
        aria-label="{{ 'accessibility.slideshow_next' | t }}"
      >
        <span class="product-recommendations-v2__arrow-icon" aria-hidden="true">
          {{ 'icon-chevron-right.svg' | inline_asset_content }}
        </span>
      </button>
    {% endcapture %}

    {% capture slides %}
      {% if onboarding %}
        {% for index in (1..4) %}
          {%- capture card -%}
            <article class="product-recommendations-v2__card">
              <div class="product-recommendations-v2__media"></div>
              <div class="product-recommendations-v2__stars" aria-hidden="true">
                {% for star in (1..5) %}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11.9984 17.2752L7.84838 19.7752C7.66504 19.8919 7.47338 19.9419 7.27338 19.9252C7.07338 19.9085 6.89838 19.8419 6.74838 19.7252C6.59838 19.6085 6.48171 19.4629 6.39838 19.2882C6.31504 19.1135 6.29838 18.9175 6.34838 18.7002L7.44838 13.9752L3.77338 10.8002C3.60671 10.6502 3.50271 10.4792 3.46138 10.2872C3.42004 10.0952 3.43238 9.90786 3.49838 9.7252C3.56438 9.54253 3.66438 9.39253 3.79838 9.2752C3.93238 9.15786 4.11571 9.08286 4.34838 9.0502L9.19838 8.6252L11.0734 4.1752C11.1567 3.9752 11.286 3.8252 11.4614 3.7252C11.6367 3.6252 11.8157 3.5752 11.9984 3.5752C12.181 3.5752 12.36 3.6252 12.5354 3.7252C12.7107 3.8252 12.84 3.9752 12.9234 4.1752L14.7984 8.6252L19.6484 9.0502C19.8817 9.08353 20.065 9.15853 20.1984 9.2752C20.3317 9.39186 20.4317 9.54186 20.4984 9.7252C20.565 9.90853 20.5777 10.0962 20.5364 10.2882C20.495 10.4802 20.3907 10.6509 20.2234 10.8002L16.5484 13.9752L17.6484 18.7002C17.6984 18.9169 17.6817 19.1129 17.5984 19.2882C17.515 19.4635 17.3984 19.6092 17.2484 19.7252C17.0984 19.8412 16.9234 19.9079 16.7234 19.9252C16.5234 19.9425 16.3317 19.8925 16.1484 19.7752L11.9984 17.2752Z" fill="#BD9D80"/>
                  </svg>
                  
                {% endfor %}
              </div>
              <h3 class="product-recommendations-v2__title">{{ 'content.product_card_placeholder' | t }}</h3>
              <p class="product-recommendations-v2__description">{{ 'content.product_card_placeholder' | t }}</p>
              <p class="product-recommendations-v2__price">{{ 1999 | money }}</p>
              <button type="button" class="product-recommendations-v2__add" disabled>{{ 'actions.add_to_cart' | t }}</button>
            </article>
          {%- endcapture -%}
          {%- render 'slideshow-slide',
            index: forloop.index0,
            children: card,
            class: 'product-recommendations-v2__slide'
          -%}
        {% endfor %}
      {% else %}
        {% for recommendation in products limit: max_products %}
          {% if recommendation.id != blank %}
            {% liquid
              assign card_variant = recommendation.selected_or_first_available_variant
              assign card_image = recommendation.featured_image
              assign card_alt = card_image.alt | default: recommendation.title
              assign card_description = recommendation.description | strip_html | strip_newlines | strip
              assign form_id = 'RecommendationsAdd-' | append: section.id | append: '-' | append: recommendation.id | append: '-' | append: forloop.index
            %}
            {%- capture card -%}
              <article class="product-recommendations-v2__card">
                <a class="product-recommendations-v2__media" href="{{ recommendation.url }}" onpointerdown="event.stopPropagation()">
                  {% if card_image != blank %}
                    {{
                      card_image
                      | image_url: width: 900
                      | image_tag:
                        class: 'product-recommendations-v2__image',
                        widths: '240, 360, 480, 720, 900',
                        sizes: '(min-width: 750px) 22vw, 45vw',
                        loading: 'lazy',
                        alt: card_alt
                    }}
                  {% endif %}
                </a>
                <div class="product-recommendations-v2__stars" aria-hidden="true">
                  {% for star in (1..5) %}
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11.9984 17.2752L7.84838 19.7752C7.66504 19.8919 7.47338 19.9419 7.27338 19.9252C7.07338 19.9085 6.89838 19.8419 6.74838 19.7252C6.59838 19.6085 6.48171 19.4629 6.39838 19.2882C6.31504 19.1135 6.29838 18.9175 6.34838 18.7002L7.44838 13.9752L3.77338 10.8002C3.60671 10.6502 3.50271 10.4792 3.46138 10.2872C3.42004 10.0952 3.43238 9.90786 3.49838 9.7252C3.56438 9.54253 3.66438 9.39253 3.79838 9.2752C3.93238 9.15786 4.11571 9.08286 4.34838 9.0502L9.19838 8.6252L11.0734 4.1752C11.1567 3.9752 11.286 3.8252 11.4614 3.7252C11.6367 3.6252 11.8157 3.5752 11.9984 3.5752C12.181 3.5752 12.36 3.6252 12.5354 3.7252C12.7107 3.8252 12.84 3.9752 12.9234 4.1752L14.7984 8.6252L19.6484 9.0502C19.8817 9.08353 20.065 9.15853 20.1984 9.2752C20.3317 9.39186 20.4317 9.54186 20.4984 9.7252C20.565 9.90853 20.5777 10.0962 20.5364 10.2882C20.495 10.4802 20.3907 10.6509 20.2234 10.8002L16.5484 13.9752L17.6484 18.7002C17.6984 18.9169 17.6817 19.1129 17.5984 19.2882C17.515 19.4635 17.3984 19.6092 17.2484 19.7252C17.0984 19.8412 16.9234 19.9079 16.7234 19.9252C16.5234 19.9425 16.3317 19.8925 16.1484 19.7752L11.9984 17.2752Z" fill="#BD9D80"/>
                    </svg>
                  {% endfor %}
                </div>
                <h3 class="product-recommendations-v2__title">
                  <a href="{{ recommendation.url }}" onpointerdown="event.stopPropagation()">{{ recommendation.title | escape }}</a>
                </h3>
                {% if card_description != blank %}
                  <p class="product-recommendations-v2__description">{{ card_description | truncate: 90 }}</p>
                {% else %}
                  <p class="product-recommendations-v2__description">&nbsp;</p>
                {% endif %}
                <p class="product-recommendations-v2__price">
                  {{ card_variant.price | money }}
                  {% if card_variant.compare_at_price > card_variant.price %}
                    <s class="product-recommendations-v2__compare">{{ card_variant.compare_at_price | money }}</s>
                  {% endif %}
                </p>
                <product-form-component
                  class="product-recommendations-v2__form"
                  data-section-id="{{ section.id }}"
                  data-product-id="{{ recommendation.id }}"
                  data-quantity-default="1"
                  on:submit="/handleSubmit"
                >
                  {% form 'product', recommendation, id: form_id, class: 'product-recommendations-v2__product-form' %}
                    <input type="hidden" name="id" value="{{ card_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button
                      type="submit"
                      name="add"
                      class="product-recommendations-v2__add"
                      onpointerdown="event.stopPropagation()"
                      {% unless card_variant.available %}
                        disabled
                      {% endunless %}
                    >
                      {% if card_variant.available %}
                        {{ 'actions.add_to_cart' | t }}
                      {% else %}
                        {{ 'content.product_badge_sold_out' | t }}
                      {% endif %}
                    </button>
                  {% endform %}
                </product-form-component>
              </article>
            {%- endcapture -%}
            {%- render 'slideshow-slide',
              index: forloop.index0,
              children: card,
              class: 'product-recommendations-v2__slide'
            -%}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endcapture %}

    {% liquid
      assign slideshow_attributes = 'data-step-one mobile-disabled tabindex="0"'
      if heading != blank
        assign slideshow_attributes = slideshow_attributes | append: ' aria-labelledby="ProductRecommendationsHeading-' | append: section.id | append: '"'
      endif
    %}

    {% render 'slideshow',
      ref: 'recommendationsCarousel',
      class: 'product-recommendations-v2__slideshow',
      slides: slides,
      header: header,
      slideshow_arrows: slideshow_arrows,
      show_arrows: false,
      infinite: false,
      initial_slide: 0,
      slide_count: shown_count,
      auto_hide_controls: false,
      attributes: slideshow_attributes
    %}
  </div>
</product-recommendations>

{% stylesheet %}
  .product-recommendations-v2-root {
    display: block;
    color: #251f1a;
  }

  .product-recommendations-v2-root .section-background {
    background-color: #fffff4;
  }

  .product-recommendations-v2 {
    --recs-visible: 4;
    --recs-gap: 20px;
  }

  .product-recommendations-v2__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 12px;
    text-align: center;
  }

  .product-recommendations-v2__eyebrow {
    margin: 0;
    color: #886848;
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  .product-recommendations-v2__heading {
    max-width: 100%;
    margin: 0;
    color: #251f1a;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 36px, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.08;
    text-align: center;
  }

  .product-recommendations-v2 slideshow-component {
    gap: 36px;
    width: 100%;
    min-width: 0;
    outline: none;
  }

  .product-recommendations-v2 slideshow-component:focus-visible {
    outline: 2px solid #251f1a;
    outline-offset: 4px;
  }

  .product-recommendations-v2 slideshow-container {
    background: transparent;
    container-type: normal;
    overflow: visible;
  }

  .product-recommendations-v2 slideshow-slides {
    align-items: stretch;
    gap: var(--recs-gap);
  }

  .product-recommendations-v2 slideshow-component slideshow-slide[aria-hidden] {
    content-visibility: visible;
  }

  .product-recommendations-v2__slide {
    flex: 0 0 auto;
    width: calc((100% - (var(--recs-visible, 4) - 1) * var(--recs-gap, 20px)) / var(--recs-visible, 4));
    min-width: 0;
    overflow: hidden;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .product-recommendations-v2__arrow {
    position: absolute;
    z-index: 3;
    top: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: 0;
    /* Half the card image height. Percent margin uses the container width. */
    margin-top: calc(((100% - (var(--recs-visible, 4) - 1) * var(--recs-gap, 20px)) / var(--recs-visible, 4)) / 2);
    padding: 0;
    border: 0;
    background: transparent;
    color: #251f1a;
    cursor: pointer;
  }

  .product-recommendations-v2__arrow--previous {
    left: 0;
    transform: translate(calc(-1 * min(100%, var(--page-margin))), -50%);
  }

  .product-recommendations-v2__arrow--next {
    right: 0;
    transform: translate(min(100%, var(--page-margin)), -50%);
  }

  .product-recommendations-v2__arrow:disabled {
    cursor: default;
    opacity: 0.35;
  }

  .product-recommendations-v2__arrow:focus-visible {
    outline: 2px solid #251f1a;
    outline-offset: 3px;
  }

  .product-recommendations-v2__arrow-icon {
    --icon-stroke-width: 1.5px;

    display: flex;
    width: 12px;
    height: 18px;
  }

  .product-recommendations-v2__arrow-icon svg {
    width: 12px;
    height: 18px;
  }

  .product-recommendations-v2__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    text-align: center;
    background: transparent;
  }

  .product-recommendations-v2__media {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: transparent;
  }

  .product-recommendations-v2__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-recommendations-v2__stars {
    display: flex;
    justify-content: center;
    gap: 3px;
    margin-top: 14px;
    color: #c4a35a;
  }

  .product-recommendations-v2__title {
    margin: 8px 0 0;
    color: #251f1a;
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
  }

  .product-recommendations-v2__title a {
    color: inherit;
    text-decoration: none;
  }

  .product-recommendations-v2__description {
    max-width: 100%;
    margin: 6px 0 0;
    overflow: hidden;
    color: #6d675f;
    font-size: 0.875rem;
    line-height: 1.4;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-recommendations-v2__price {
    margin: 8px 0 0;
    color: #251f1a;
    font-size: 0.95rem;
    line-height: 1.3;
    text-align: center;
  }

  .product-recommendations-v2__compare {
    margin-left: 6px;
    color: #6d675f;
    text-decoration: line-through;
  }

  .product-recommendations-v2__form,
  .product-recommendations-v2__product-form {
    width: 100%;
    margin-top: auto;
    padding-top: 14px;
  }

  .product-recommendations-v2__add {
    width: 100%;
    margin: 0;
    padding: 12px 16px;
    border: 0;
    border-radius: 4px;
    background: #886848;
    color: #fffff4;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    cursor: pointer;
  }

  .product-recommendations-v2__add:disabled {
    cursor: default;
    opacity: 0.55;
  }

  .product-recommendations-v2__add:focus-visible,
  .product-recommendations-v2__title a:focus-visible,
  .product-recommendations-v2__media:focus-visible {
    outline: 2px solid #251f1a;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .product-recommendations-v2 {
      --recs-visible: 2;
      --recs-gap: 20px;
    }

    .product-recommendations-v2__heading {
      font-size: 32px;
    }

    .product-recommendations-v2 slideshow-component[mobile-disabled] slideshow-slides {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      overflow: visible;
      scroll-snap-type: none;
      cursor: auto;
    }

    .product-recommendations-v2 slideshow-slide.product-recommendations-v2__slide {
      width: auto;
      max-width: 100%;
      content-visibility: visible;
      scroll-snap-align: unset;
      scroll-snap-stop: unset;
    }

    .product-recommendations-v2__arrow {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_recommendations_v2",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "SHOP THE ROUTINE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Whatever Your Hair Problem, We've Got A Fix"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "related",
          "label": "t:options.related"
        },
        {
          "value": "complementary",
          "label": "t:options.complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "paragraph",
      "content": "t:content.complementary_products"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "t:settings.fallback_collection",
      "info": "t:content.recommendations_fallback"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.product_recommendations_v2",
      "category": "t:categories.products",
      "settings": {
        "eyebrow": "SHOP THE ROUTINE",
        "heading": "Whatever Your Hair Problem, We've Got A Fix",
        "product": "{{ closest.product }}",
        "recommendation_type": "related",
        "max_products": 8,
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    }
  ]
}
{% endschema %}
